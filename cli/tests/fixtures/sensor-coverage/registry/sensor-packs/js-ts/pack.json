{
  "name": "js-ts",
  "sensors": {},
  "coverage": {
    "schemaVersion": 1,
    "classes": {
      "formatting": {
        "description": "Mechanical formatting consistency",
        "detectors": [{ "sensor": "format", "evidence": { "commandIncludes": ["prettier"] } }],
        "remedy": { "summary": "Add a formatter", "command": "npm install --save-dev prettier" }
