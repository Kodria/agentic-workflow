{
  "name": "agentic-workflow-manager",
  "version": "8.0.0",
  "main": "dist/src/index.js",
  "bin": {
    "awm": "./dist/src/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kodria/agentic-workflow.git",
    "directory": "cli"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config eslint.config.awm.mjs --cache --format json",
    "depcheck": "depcruise --config .dep-cruiser.awm.js src",
    "test": "jest --runInBand",
    "start": "ts-node src/index.ts",
    "prerelease": "npm run build",
    "release": "node dist/src/release/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "docs:matrix": "ts-node scripts/support-matrix.ts && ts-node scripts/sensor-support-matrix.ts --registry-root tests/fixtures/sensor-support-matrix/registry"
  },
  "keywords": [
    "agentic",
    "workflow",
    "cli",
    "skills",
    "ai"
  ],
  "author": "Kodria",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "description": "CLI to manage Agentic Workflows - install skills, workflows, and processes for AI agents",
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "semver": "^7.7.4",
    "simple-git": "^3.32.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^25.3.0",
    "@types/semver": "^7.7.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.4.1",
    "jest": "^30.2.0",
    "js-yaml": "4.1.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
